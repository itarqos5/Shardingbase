+    // Shardingbase start - event- and reward-free pre-join state restoration
+    public void shardingbaseRestoreProgress(
+        final ServerAdvancementManager manager,
+        final Map<Identifier, Set<String>> restored
+    ) {
+        this.clearTriggers();
+        this.progress.clear();
+        this.visible.clear();
+        this.rootsToUpdate.clear();
+        this.progressChanged.clear();
+        this.isFirstPacket = true;
+        this.lastSelectedTab = null;
+        this.tree = manager.tree();
+        for (final Entry<Identifier, Set<String>> entry : restored.entrySet()) {
+            final AdvancementHolder holder = manager.get(entry.getKey());
+            if (holder == null) {
+                throw new IllegalArgumentException("Unknown advancement " + entry.getKey());
+            }
+            final AdvancementProgress advancementProgress = this.getOrStartProgress(holder);
+            for (final String criterion : entry.getValue()) {
+                if (advancementProgress.getCriterion(criterion) == null) {
+                    throw new IllegalArgumentException("Unknown criterion " + criterion + " for " + entry.getKey());
+                }
+                advancementProgress.grantProgress(criterion);
+            }
+            this.progressChanged.add(holder);
+        }
+        for (final AdvancementHolder holder : manager.getAllAdvancements()) {
+            this.registerListeners(holder);
+            this.markForVisibilityUpdate(holder);
+        }
+    }
+    // Shardingbase end - event- and reward-free pre-join state restoration
+
